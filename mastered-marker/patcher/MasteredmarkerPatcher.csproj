<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>MasteredmarkerPatcher</AssemblyName>
    <RootNamespace>MasteredmarkerPatcher</RootNamespace>
    <!-- Bump this if a build ever dies with 'An Application Control policy has blocked
         this file' - Smart App Control blocks by assembly hash and .NET builds are
         deterministic, so only a content change gets a new hash. -->
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="UAssetAPI" Version="1.1.0" />
    <ProjectReference Include="..\..\lib\ZSPatchKit\ZSPatchKit.csproj" />
  </ItemGroup>

</Project>
